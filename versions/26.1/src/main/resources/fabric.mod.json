{
  "schemaVersion": 1,
  "id": "replaymod",
  "version": "${version}",

  "name": "Recap Mod",
  "description": "Recap Mod - a Minecraft mod which allows you to record, replay and share your Minecraft experience. Forked from Replay Mod.",
  "authors": [
    "TurtleOfficials"
  ],
  "contributors": [
    "CrushedPixel",
    "johni0702"
  ],
  "contact": {
    "homepage": "https://github.com/Endiq-jar/Recap",
    "sources": "https://github.com/Endiq-jar/Recap",
    "issues": "https://github.com/Endiq-jar/Recap/issues"
  },

  "license": "GPL-3.0-or-later",
  "icon": "assets/replaymod/favicon_logo.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "com.replaymod.core.ReplayModBackend"
    ],
    "modmenu": [
      "com.replaymod.core.gui.ModMenuApiImpl"
    ],
    "frex_flawless_frames": [
      "com.replaymod.render.utils.FlawlessFrames::registerConsumer"
    ],
    "preLaunch": [
      "com.replaymod.core.DummyChainLoadEntryPoint",
      "com.replaymod.core.MixinExtrasInit"
    ],
    "mm:early_risers": [
      "com.replaymod.core.ReplayModMMLauncher"
    ]
  },
  "mixins": [
    "mixins.jgui.json",
    "mixins.nonmmlauncher.replaymod.json"
  ],

  "depends": {
    "fabricloader": ">=0.18.5",
    "fabric-networking-api-v1": "*",
    "fabric-key-mapping-api-v1": "*",
    "fabric-resource-loader-v0": "*"
  },

  "custom": {
    "mm:early_risers": [
      "com.replaymod.core.ReplayModMMLauncher"
    ],
    "modmenu:clientsideOnly": true
  }
}
